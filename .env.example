# Copia este archivo como .env y ajusta los valores. El archivo .env nunca se versiona.

PORT=3001
FRONTEND_ORIGIN=http://localhost:4200

# --- Base de datos -----------------------------------------------------------
# La aplicacion se conecta con un rol de privilegios reducidos (sin UPDATE/DELETE sobre la bitacora).
DATABASE_URL=postgresql://cvsp_app:cvsp_app_dev@127.0.0.1:5433/cvsp
# Las migraciones y la semilla usan el rol propietario del esquema.
DATABASE_MIGRATION_URL=postgresql://cvsp_owner:cvsp_owner_dev@127.0.0.1:5433/cvsp
DATABASE_APP_ROLE=cvsp_app
# Base que usan las pruebas de extremo a extremo (se recrea en cada ejecucion).
DATABASE_TEST_URL=postgresql://cvsp_app:cvsp_app_dev@127.0.0.1:5433/cvsp_test
DATABASE_TEST_MIGRATION_URL=postgresql://cvsp_owner:cvsp_owner_dev@127.0.0.1:5433/cvsp_test

# --- Sesion ------------------------------------------------------------------
# Cadena aleatoria larga: firma la cookie de sesion.
SESSION_SECRET=
SESSION_TTL_HOURS=8

# --- Identidad ---------------------------------------------------------------
# local = proveedor de desarrollo con cuentas sinteticas (src/infrastructure/identity/dev-accounts.ts).
IDENTITY_PROVIDER=local
# Contrasena compartida de las cuentas de desarrollo. Vacia = nadie puede iniciar sesion.
LOCAL_IDENTITY_PASSWORD=

# --- Moodle (solo lectura) ---------------------------------------------------
MOODLE_BASE_URL=http://127.0.0.1:8090
# Token del servicio web. Lo genera scripts/moodle/configurar-servicio-web.php.
MOODLE_WS_TOKEN=
MOODLE_TIMEOUT_MS=5000

# --- Archivos de los recursos ------------------------------------------------
# Carpeta donde se guardan las versiones de los recursos (en produccion: almacenamiento de objetos).
STORAGE_DIR=storage
# Tamano maximo de cada archivo, en MB.
RESOURCE_MAX_MB=20
